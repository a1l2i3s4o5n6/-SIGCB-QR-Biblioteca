# SIGCB-QR — Variables de entorno
# Copiar a .env y ajustar según entorno

# Base de datos
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sigcbqr
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here
POSTGRES_PASSWORD=your_password_here
POSTGRES_USER=postgres
POSTGRES_DB=sigcbqr

# Credenciales de los usuarios semilla (SOLO desarrollo/despliegue local).
# La migracion Flyway V7 las lee de estas variables (placeholders) para
# re-hashear los usuarios. NUNCA usar estos valores en un despliegue real:
# en produccion los usuarios semilla se desactivan (db/migration-prod/V13)
# y un operador debe crear las cuentas reales. Si se dejan vacias, V7 no
# modifica las contraseñas previas.
SEED_ADMIN_PASSWORD=admin123
SEED_BIBLIO_PASSWORD=biblio123
SEED_STUDENT_PASSWORD=estudiante123

# pgAdmin (consola de administracion en http://localhost:5050)
PGADMIN_PASSWORD=your_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_ISSUER=sigcbqr-api
JWT_AUDIENCE=sigcbqr-frontend
JWT_SECURE_COOKIE=false
# Clave de firma HMAC en BASE64 (64 bytes / 512 bits).
# No vale cualquier cadena: debe decodificar como base64 o la API no arranca.
# Generar con:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(64)).decode())"
JWT_SECRET=

# Cache
CACHE_DEFAULT_TTL_SECONDS=300
