# SIGCB-QR — Variables de entorno
# Copiar a .env y ajustar según entorno

# Base de datos
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sigcbqr
SPRING_DATASOURCE_USERNAME=postgres
