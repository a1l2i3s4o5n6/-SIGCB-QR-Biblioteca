# SIGCB-QR — Variables de entorno
# Copiar a .env y ajustar según entorno

# Base de datos
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sigcbqr
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here
POSTGRES_PASSWORD=your_password_here
POSTGRES_USER=postgres
POSTGRES_DB=sigcbqr

# pgAdmin (consola de administracion en http://localhost:5050)
PGADMIN_PASSWORD=your_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_ISSUER=sigcbqr-api
JWT_AUDIENCE=sigcbqr-frontend
JWT_SECURE_COOKIE=false
JWT_SECRET=your_generated_secret_here

# Cache
CACHE_DEFAULT_TTL_SECONDS=300
