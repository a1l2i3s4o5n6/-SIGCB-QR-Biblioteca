# ======================================================
# Overrides OBLIGATORIOS para PRODUCCIÓN (M5)
# Copiar/ajustar estos valores en el entorno real.
# También pueden inyectarse como variables de entorno en
# el servicio `frontend` de docker-compose (tienen prioridad
# sobre este archivo).
# ======================================================
APP_ENV=production
# NUNCA activar debug en producción
APP_DEBUG=false
APP_URL=https://biblioteca.edu.ec
LOG_LEVEL=warning

# Sesión encriptada en producción
SESSION_ENCRYPT=true
SESSION_DRIVER=file
SESSION_LIFETIME=120

# URL base del backend Spring Boot en producción (contexto BFF).
# Se debe fijar al nombre DNS/servicio real del API.
API_BASE_URL=http://sigcbqr-api:8080/api