    affiliation: "Universidad Técnica Estatal de Quevedo (UTEQ)"
repository-code: "https://github.com/a1l2i3s4o5n6/-SIGCB-QR-Biblioteca"
keywords:
  - "gestión bibliotecaria"
  - "biblioteca universitaria"
  - "códigos QR"
  - "spring-boot"
  - "laravel"
